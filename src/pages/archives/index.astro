---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ArchiveItem from "@/components/ArchiveItem.astro";
import { postFilter } from "@/utils/postFilter";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { getPostDateParts } from "./_utils/getPostDateParts";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

// Screen readers get the year/month counts with their unit; the bare
// superscript number is hidden from them.
const postCount = (count: number) =>
  tplStr(count === 1 ? t.a11y.postCountOne : t.a11y.postCount, { count });

const posts = await getCollection("posts", ({ id }) => id.startsWith("zh/"));
const filteredPosts = posts.filter(postFilter);
// Only the month name is wanted, so format a fixed UTC date in UTC: no zone
// can shift it into a neighbouring month.
const monthFormatter = new Intl.DateTimeFormat(locale, {
  month: "long",
  timeZone: "UTC",
});
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      Object.entries(
        getPostsByGroupCondition(
          filteredPosts,
          post => getPostDateParts(post).year
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <section class="mb-10">
            <h2 class="inline text-2xl font-bold">{year}</h2>
            <sup aria-hidden="true" class="text-muted-foreground text-sm">
              {yearGroup.length}
            </sup>
            <span class="sr-only">{postCount(yearGroup.length)}</span>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => getPostDateParts(post).month
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="mt-6 flex flex-col sm:flex-row sm:items-baseline">
                  <div class="min-w-36 text-lg">
                    <h3 class="inline font-bold">
                      {monthFormatter.format(
                        Date.UTC(2000, Number(month) - 1, 1)
                      )}
                    </h3>
                    <sup
                      aria-hidden="true"
                      class="text-muted-foreground text-xs"
                    >
                      {monthGroup.length}
                    </sup>
                    <span class="sr-only">{postCount(monthGroup.length)}</span>
                  </div>
                  <ul class="mt-2 min-w-0 sm:mt-0">
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <ArchiveItem {...data} />
                      ))}
                  </ul>
                </div>
              ))}
          </section>
        ))
    }
  </Main>

  <Footer />
</Layout>
