---
import { getRelativeLocaleUrl } from "astro:i18n";
// Keep above PagefindSearch, which pulls in the Pagefind CSS: importing it
// later renames the shared CSS chunk, so the built page would change even
// with the feature off.
import AiSearch from "@/components/AiSearch.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PagefindSearch from "@/components/PagefindSearch.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `search` feature is not enabled
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc}>
    {
      import.meta.env.DEV && (
        <div class="bg-muted/75 mb-4 space-y-4 rounded p-4">
          <p>{t.search.devHint}</p>
          <code class="bg-background block rounded px-2 py-1">
            pnpm run build
          </code>
        </div>
      )
    }
    <PagefindSearch />
    {config.features.aiSearch && <AiSearch />}
  </Main>

  <Footer />
</Layout>
