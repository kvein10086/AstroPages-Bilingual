---
import { getPostUrl } from "@/utils/getPostPaths";
import type { RelatedPost } from "@/utils/getRelatedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  posts: RelatedPost[];
};

const { posts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// The date the post's card and header show (Datetime.astro): its update when
// there is a later one, labelled as such, in the post's timezone and spelled
// in the reader's language.
const formatDate = ({ datetime, timezone }: RelatedPost) =>
  new Intl.DateTimeFormat(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: timezone ?? config.site.timezone,
  }).format(datetime);
---

{
  posts.length > 0 && (
    <>
      <section
        data-pagefind-ignore
        aria-labelledby="related-posts-title"
        class="my-8"
      >
        <h2 id="related-posts-title" class="font-medium">
          {t.post.relatedPosts}
        </h2>
        <ul class="mt-3 space-y-2">
          {posts.map(post => (
            <li class="flex flex-wrap items-baseline gap-x-3">
              <a
                href={getPostUrl(post.id, post.filePath, locale)}
                class:list={[
                  "text-accent/85 decoration-dashed underline-offset-4",
                  "hover:underline focus-visible:no-underline",
                ]}
              >
                {post.title}
              </a>
              <span class="text-muted-foreground text-sm whitespace-nowrap">
                {post.isModified && `${t.post.updatedAt}: `}
                <time datetime={post.datetime.toISOString()}>
                  {formatDate(post)}
                </time>
              </span>
            </li>
          ))}
        </ul>
      </section>
      <hr class="my-8 border-dashed" />
    </>
  )
}
