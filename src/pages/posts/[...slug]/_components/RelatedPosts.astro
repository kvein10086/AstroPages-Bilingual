---
import { getPostUrl } from "@/utils/getPostPaths";
import type { RelatedPost } from "@/utils/getRelatedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  posts: RelatedPost[];
};

const { posts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Same wording as the post dates (Datetime.astro): each date in its post's
// timezone, spelled in the reader's language.
const formatDate = ({ pubDatetime, timezone }: RelatedPost) =>
  new Intl.DateTimeFormat(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: timezone ?? config.site.timezone,
  }).format(pubDatetime);
---

{
  posts.length > 0 && (
    <>
      <section
        data-pagefind-ignore
        aria-labelledby="related-posts-title"
        class="my-8"
      >
        <h2 id="related-posts-title" class="font-medium">
          {t.post.relatedPosts}
        </h2>
        <ul class="mt-3 space-y-2">
          {posts.map(post => (
            <li class="flex flex-wrap items-baseline gap-x-3">
              <a
                href={getPostUrl(post.id, post.filePath, locale)}
                class:list={[
                  "text-accent/85 decoration-dashed underline-offset-4",
                  "hover:underline focus-visible:no-underline",
                ]}
              >
                {post.title}
              </a>
              <time
                class="text-muted-foreground text-sm whitespace-nowrap"
                datetime={post.pubDatetime.toISOString()}
              >
                {formatDate(post)}
              </time>
            </li>
          ))}
        </ul>
      </section>
      <hr class="my-8 border-dashed" />
    </>
  )
}
