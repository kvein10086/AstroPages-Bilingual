---
import type { GalleryAlbum } from "@/types/gallery";
import { tplStr, useTranslations } from "@/i18n";
import { formatDuration } from "@/utils/media";
import { getGalleryFacets } from "@/utils/getGalleryAlbums";
import { UNKNOWN_FACET } from "@/utils/galleryFacets";
import IconFilter from "@/assets/icons/IconFilter.svg";
import config from "@/config";

interface Props {
  albums: GalleryAlbum[];
}

const { albums } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Localized PhotoSwipe button titles / error message, read by the client script.
const pswpStrings = JSON.stringify({
  close: t.a11y.lightboxClose,
  zoom: t.a11y.lightboxZoom,
  prev: t.a11y.lightboxPrev,
  next: t.a11y.lightboxNext,
  error: t.a11y.lightboxError,
  videoError: t.a11y.lightboxVideoError,
});

// Filter dimensions derived from the photos' EXIF; none → no filter UI.
const facetGroups = getGalleryFacets(albums, t);
const photoCount = albums.reduce((n, album) => n + album.photos.length, 0);
const summaryAll = tplStr(
  albums.length === 1 ? t.gallery.summaryAllOneAlbum : t.gallery.summaryAll,
  { photos: photoCount, albums: albums.length }
);

// Summary / announcement templates, filled in by the client filter script.
const filterStrings = JSON.stringify({
  summaryAll: t.gallery.summaryAll,
  summaryAllOneAlbum: t.gallery.summaryAllOneAlbum,
  summaryFiltered: t.gallery.summaryFiltered,
  filtersReset: t.gallery.filtersReset,
});

const chipClass = [
  "inline-flex min-h-8 items-center gap-1.5 rounded-full border px-3 text-xs transition-colors",
  "border-border text-foreground hover:border-accent hover:text-accent",
  "aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent",
  "data-empty:opacity-40",
];
---

{
  albums.length === 0 ? (
    <p class="text-muted-foreground py-16 text-center italic">
      {t.pages.galleryEmpty}
    </p>
  ) : (
    <div class="gallery" data-pswp-strings={pswpStrings}>
      {facetGroups.length > 0 && (
        <div
          class="g-filter mb-8"
          data-gallery-filter
          data-filter-strings={filterStrings}
          hidden
        >
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <button
              type="button"
              class="hover:text-accent aria-expanded:text-accent inline-flex min-h-8 items-center gap-1.5 text-sm font-medium transition-colors"
              aria-expanded="false"
              aria-controls="g-filter-panel"
              data-filter-toggle
            >
              <IconFilter class="size-4" aria-hidden="true" />
              {t.gallery.filter}
            </button>
            <p
              class="text-muted-foreground text-sm tabular-nums"
              aria-live="polite"
              data-filter-summary
            >
              {summaryAll}
            </p>
            <button
              type="button"
              class="text-muted-foreground hover:text-accent inline-flex min-h-8 items-center text-sm underline decoration-dashed decoration-1 underline-offset-4 transition-colors"
              data-filter-clear
              hidden
            >
              {t.gallery.clear}
            </button>
          </div>
          <div
            id="g-filter-panel"
            class="border-border mt-2 flex flex-col gap-3 border-t pt-3"
            data-filter-panel
            hidden
          >
            {albums.length >= 2 && (
              <nav
                class="g-albums flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:gap-4"
                aria-labelledby="g-facet-albums"
              >
                <span
                  id="g-facet-albums"
                  class="text-muted-foreground shrink-0 text-xs sm:w-20"
                >
                  {t.gallery.albumsNav}
                </span>
                <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                  {albums.map(album => (
                    <li>
                      <a
                        href={`#album-${album.post.slug}`}
                        class="text-foreground hover:text-accent inline-flex min-h-8 items-center gap-1.5 whitespace-nowrap transition-colors aria-disabled:opacity-40"
                      >
                        {album.post.title}
                        <span
                          class="text-muted-foreground tabular-nums"
                          data-album-count
                        >
                          {album.photos.length}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
            {facetGroups.map(group => (
              <div
                role="group"
                aria-labelledby={`g-facet-${group.key}`}
                class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:gap-4"
              >
                <span
                  id={`g-facet-${group.key}`}
                  class="text-muted-foreground shrink-0 text-xs sm:w-20"
                >
                  {t.gallery[group.key]}
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {group.options.map(option => (
                    <button
                      type="button"
                      class:list={chipClass}
                      aria-pressed="false"
                      data-facet={group.key}
                      data-value={option.value}
                    >
                      {option.label}
                      <span class="tabular-nums opacity-60" data-count>
                        {option.count}
                      </span>
                    </button>
                  ))}
                  {group.unknown > 0 && (
                    <button
                      type="button"
                      class:list={chipClass}
                      aria-pressed="false"
                      data-facet={group.key}
                      data-value={UNKNOWN_FACET}
                    >
                      {t.gallery.unknown}
                      <span class="tabular-nums opacity-60" data-count>
                        {group.unknown}
                      </span>
                    </button>
                  )}
                </div>
              </div>
            ))}
          </div>
          <p
            class="text-muted-foreground py-16 text-center italic"
            data-filter-empty
            hidden
          >
            {t.gallery.noMatch}
          </p>
        </div>
      )}
      {albums.map(album => (
        <section id={`album-${album.post.slug}`} class="mb-12 scroll-mt-6">
          <div class="g-head mb-3 flex items-baseline justify-between gap-4">
            <h2 class="text-lg font-medium">
              <a
                href={album.post.url}
                class="text-foreground hover:text-accent underline decoration-dashed decoration-1 underline-offset-4 transition-colors"
              >
                {album.post.title}
              </a>
            </h2>
            <time
              class="text-muted-foreground shrink-0 text-sm"
              datetime={album.post.date.toISOString()}
            >
              {dateFormatter.format(album.post.date)}
            </time>
          </div>
          <div class="g-grid">
            {album.photos.map(photo => (
              <a
                class:list={[
                  "g-item",
                  { "g-item--video": photo.type === "video" },
                ]}
                href={photo.src}
                target="_blank"
                rel="noopener noreferrer"
                style={{ "--ar": photo.width / photo.height }}
                data-pswp-width={photo.width}
                data-pswp-height={photo.height}
                data-pswp-type={photo.type === "video" ? "video" : undefined}
                data-caption={photo.type === "video" ? photo.alt : undefined}
                aria-label={
                  photo.type === "video"
                    ? `${t.a11y.playVideo}: ${photo.alt}`
                    : undefined
                }
                data-exif-camera={photo.camera ?? ""}
                data-exif-settings={photo.settings ?? ""}
                data-f-camera={photo.facets?.camera}
                data-f-lens={photo.facets?.lens}
                data-f-focal={photo.facets?.focal}
              >
                {photo.thumbSrc && (
                  <img
                    src={photo.thumbSrc}
                    alt={photo.alt}
                    width={photo.width}
                    height={photo.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {photo.type === "video" && (
                  <span class="g-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                )}
                {photo.duration ? (
                  <span class="g-duration" aria-hidden="true">
                    {formatDuration(photo.duration)}
                  </span>
                ) : null}
                {(photo.alt || photo.camera || photo.settings) && (
                  <div class="g-overlay" aria-hidden="true">
                    {photo.alt && <span class="g-caption">{photo.alt}</span>}
                    {photo.camera && <span class="g-meta">{photo.camera}</span>}
                    {photo.settings && (
                      <span class="g-meta">{photo.settings}</span>
                    )}
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  )
}

<style>
  /* CSS-only justified grid: each item grows in proportion to its aspect ratio
     so rows share a common height; the ::after spacer keeps the last (partial)
     row left-aligned instead of stretching its items across the full width. */
  /* Album-app breakout: the photo rows and each album's title/date row
     escape the text column up to ~80% of the viewport (capped for ultrawide
     monitors) and re-center themselves, so titles/dates hug the grid edges;
     the page title/description above stay at the regular content width. */
  .g-head,
  .g-filter,
  .g-grid {
    --g-wide: max(100%, min(80vw, 100rem));
    width: var(--g-wide);
    margin-inline: calc((100% - var(--g-wide)) / 2);
  }
  .g-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .g-grid::after {
    content: "";
    flex-grow: 1000000;
  }
  /* Album-app feel on phones: photo rows bleed to the screen edges by
     cancelling the page's 1rem side padding; titles/dates stay padded. */
  @media (width < 40rem) {
    .g-head,
    .g-filter {
      width: 100%;
      margin-inline: 0;
    }
    /* The album index becomes one swipeable row instead of a tall list. */
    .g-albums ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      /* A scroller clips at its padding box; leave room for the links'
         focus outline, and cancel the padding so nothing shifts. */
      padding: 0.25rem;
      margin: -0.25rem;
    }
    .g-albums ul::-webkit-scrollbar {
      display: none;
    }
    .g-grid {
      width: calc(100% + 2rem);
      margin-inline: -1rem;
    }
    .g-grid .g-item {
      border-radius: 0;
    }
  }
  .g-item {
    position: relative;
    aspect-ratio: var(--ar);
    flex-grow: calc(var(--ar) * 100);
    flex-basis: calc(var(--ar) * 11rem);
    overflow: hidden;
    border-radius: 0.25rem;
    /* Doubles as a loading placeholder before the thumbnail paints. */
    background-color: var(--color-muted);
    /* Skip rendering work for off-screen photos. Safe to apply per item (rather
       than per album) because the box is sized entirely by `flex-basis` and
       `aspect-ratio` above, never by its contents — so no `contain-intrinsic-size`
       guess is needed and the document height stays exact while scrolling. */
    content-visibility: auto;
  }
  .g-item img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* Video affordances. Both sit above the poster and below the hover overlay,
     and neither takes the pointer — the whole tile is the click target. */
  .g-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background-color: rgb(0 0 0 / 0.55);
    color: #fff;
    pointer-events: none;
    transition: background-color 0.2s ease;
  }
  .g-play svg {
    height: 1.25rem;
    width: 1.25rem;
    /* The glyph's own bearing sits left of centre; nudge it back onto the axis. */
    margin-left: 0.125rem;
  }
  .g-item:hover .g-play,
  .g-item:focus-visible .g-play {
    background-color: rgb(0 0 0 / 0.75);
  }
  /* Top-right, deliberately clear of the caption overlay that fills the bottom. */
  .g-duration {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    border-radius: 0.25rem;
    background-color: rgb(0 0 0 / 0.6);
    padding: 0.0625rem 0.3125rem;
    color: #fff;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    pointer-events: none;
  }

  .g-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.125rem;
    padding: 0.5rem 0.625rem;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.72) 0%,
      rgb(0 0 0 / 0.35) 35%,
      transparent 70%
    );
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    /* The caption/EXIF text is a hover affordance that touch devices never see
       (see the `hover: hover` query below), yet rendering it still makes the
       browser fetch every CJK webfont subset those captions happen to use — on
       a full gallery page that measured 673 KB of woff2 competing with the
       thumbnails and with the scripts that power the lightbox. Skipping the
       contents defers that until the pointer actually arrives. */
    content-visibility: hidden;
  }
  /* Reveal on hover only for real pointers; touch devices rely on the lightbox. */
  @media (hover: hover) and (pointer: fine) {
    .g-item:hover .g-overlay {
      opacity: 1;
      content-visibility: visible;
    }
  }
  /* Keyboard parity: focusing an item shows its overlay + a visible outline. */
  .g-item:focus-visible {
    outline: 2px dashed var(--color-accent);
    outline-offset: 2px;
  }
  .g-item:focus-visible .g-overlay {
    opacity: 1;
    content-visibility: visible;
  }
  .g-caption {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.4);
  }
  .g-meta {
    overflow: hidden;
    font-size: 0.6875rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.75;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.4);
  }
</style>

<script>
  import type PhotoSwipeLightbox from "photoswipe/lightbox";
  import { createViewer, parseViewerStrings } from "@/scripts/photoViewer";
  import { onPageReady } from "@/scripts/onPageReady";
  import { initGalleryFilter } from "@/scripts/galleryFilter";

  let lightbox: PhotoSwipeLightbox | null = null;

  function destroyLightbox() {
    lightbox?.destroy();
    lightbox = null;
  }

  function initGallery() {
    // Re-init cleanly across view transitions.
    destroyLightbox();

    if (!document.querySelector(".g-grid")) return;

    lightbox = createViewer(
      {
        // Each `.g-grid` is an independent album; arrows stay within one album
        // and skip items the filter has hidden (the selector is re-run on
        // every open, so no re-init is needed when the filter changes).
        gallery: ".g-grid",
        children: "a.g-item:not([hidden])",
      },
      parseViewerStrings(
        document.querySelector<HTMLElement>("[data-pswp-strings]")
      )
    );
    lightbox.init();

    initGalleryFilter();
  }

  onPageReady(initGallery);
  document.addEventListener("astro:before-swap", destroyLightbox);
</script>
