---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { tplStr, useTranslations } from "@/i18n";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  /** Minutes, from `getPostReadingTime`; omitted or `null` shows none. */
  readingTime?: number | null;
  /**
   * Hand the publish date to Pagefind: a `date` sort key, and metadata the
   * search results show. Only for the post header: a page's first sort value
   * wins, and list pages aren't indexed at all.
   */
  searchMeta?: boolean;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  readingTime,
  searchMeta = false,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const shown =
  modDatetime && modDatetime > pubDatetime ? modDatetime : pubDatetime;
const isModified = shown !== pubDatetime;

const datetime = new Date(shown);

// Intl shifts the instant into the post's timezone and words it in the reader's
// language — "Aug 30, 2026" in English, "2026年8月30日" in Chinese.
const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: postTimezone ?? config.site.timezone,
});
const date = dateFormatter.format(datetime);

// Pagefind compares sort values as text, and ISO strings sort chronologically.
// The metadata, though, is printed under each search result as "Key: value",
// so it gets a localised key and the publish date as readers see it
// ("发布于: 2026年6月9日") instead of a raw timestamp under an English "Date".
const pubDate = new Date(pubDatetime);
const searchSort = searchMeta ? `date:${pubDate.toISOString()}` : undefined;
const searchInfo = searchMeta
  ? `${t.post.publishedAt}:${dateFormatter.format(pubDate)}`
  : undefined;
---

<div
  class:list={[
    "text-muted-foreground flex flex-wrap items-center gap-x-2",
    className,
  ]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        {t.post.updatedAt}:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
    data-pagefind-meta={searchInfo}
    data-pagefind-sort={searchSort}
  >
    {date}
  </time>
  {
    readingTime && (
      <span
        class:list={[
          "inline-flex gap-x-2 text-sm whitespace-nowrap",
          { "sm:text-base": size === "lg" },
        ]}
        data-pagefind-ignore
      >
        {/* One unbreakable unit: a narrow screen wraps the whole estimate
            onto its own line instead of stranding the separator. */}
        <span aria-hidden="true">·</span>
        {tplStr(t.post.readingTime, { n: readingTime })}
      </span>
    )
  }
</div>
