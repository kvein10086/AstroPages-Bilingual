---
type Props = {
  class?: string;
  variant?: /** No borders */
    | "minimal"
    /** 1st, 3rd, 5th … body rows tinted — classic zebra. */
    | "striped"
    /** 1st, 3rd, 5th … body rows tinted + no borders. */
    | "striped-minimal";
};

const { class: className, variant } = Astro.props;

const variantClasses = {
  minimal: "[&_td]:border-0 [&_th]:border-0",
  striped: "[&_tbody_tr]:odd:bg-muted/25",
};
---

<div
  data-table-variant={variant}
  class:list={[
    "overflow-hidden [&_table]:my-0 [&_table]:min-w-xl",
    variant === "minimal" && variantClasses.minimal,
    variant === "striped" && variantClasses.striped,
    variant === "striped-minimal" &&
      `${variantClasses.minimal} ${variantClasses.striped}`,
    className,
  ]}
>
  {
    /* The scroller shares `.table-wrap` with the wrapper rehypeTableWrap puts
    around plain markdown tables (which skips tables inside this component),
    so both are keyboard-scrollable with the same focus ring. The outer
    `overflow-hidden` box shapes the rest: it would clip a ring drawn outside
    the scroller, so the ring is drawn inset, and it would stop the wrapper's
    margins from collapsing into the neighbouring paragraphs', so `my-0` keeps
    this component's flush spacing. */
  }
  <div
    class="table-wrap relative my-0 w-full overflow-x-auto focus-visible:-outline-offset-2"
    tabindex="0"
  >
    <slot />
  </div>
</div>
