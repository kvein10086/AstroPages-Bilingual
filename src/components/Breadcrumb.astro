---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  /**
   * Display names for URL segments whose slug is not what readers should
   * see, keyed by the decoded segment — e.g. `{ "web-dev": "Web Dev" }` on a
   * tag page, so the crumb shows the tag as written instead of its slug.
   */
  labels?: Record<string, string>;
};

const { labels = {} } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

// Get url array from path
// eg: /tags/%E6%91%84%E5%BD%B1/2 => ['tags', '摄影', '2']
const segments = currentUrlPath.split("/").filter(Boolean).map(decodeSegment);

const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  tags: t.nav.tags,
  about: t.nav.about,
  archives: t.nav.archives,
  gallery: t.nav.gallery,
  search: t.nav.search,
};

// Only these positions hold a page number: /posts/[page] and
// /tags/[tag]/[page]. A tag that happens to be numeric (/tags/2024) must
// not be mistaken for one.
const isPageSegment = (index: number) =>
  /^\d+$/.test(segments[index]) &&
  ((segments[0] === "posts" && index === 1) ||
    (segments[0] === "tags" && index === 2));

type Crumb = {
  label: string;
  href: string;
  /** Raw slug shown as-is; capitalised the way the template always did. */
  isSlug: boolean;
};

// Home » Posts » 第 2 页 / Home » Tags » Web Dev » Page 2. The page number is
// a crumb of its own so its parent links back to page 1; page 1 is that
// parent, so it gets no page crumb at all.
const crumbs: Crumb[] = segments.flatMap((segment, index) => {
  const href = getRelativeLocaleUrl(
    locale,
    segments.slice(0, index + 1).join("/")
  );

  if (isPageSegment(index)) {
    const n = Number(segment);
    return n > 1
      ? [{ label: tplStr(t.pagination.pageN, { n }), href, isSlug: false }]
      : [];
  }

  const label = labels[segment] ?? (index === 0 && navLabels[segment]);
  return [{ label: label || segment, href, isSlug: !label }];
});
---

<nav class="app-layout mt-8 mb-1" aria-label={t.a11y.breadcrumb}>
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href={getRelativeLocaleUrl(locale, "")} class="opacity-80">
        {t.nav.home}
      </a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      crumbs.map(({ label, href, isSlug }, index) =>
        index + 1 === crumbs.length ? (
          <li>
            <span
              class:list={["opacity-75", { capitalize: isSlug }]}
              aria-current="page"
            >
              {label}
            </span>
          </li>
        ) : (
          <li>
            <a {href} class:list={["opacity-70", { capitalize: isSlug }]}>
              {label}
            </a>
            <span aria-hidden="true" class="opacity-70">
              &raquo;
            </span>
          </li>
        )
      )
    }
  </ul>
</nav>
