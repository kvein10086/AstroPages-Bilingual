---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);

// Astro's paginate() hands out /posts/3 without a trailing slash, while every
// other internal link (and the canonical URL) ends in one; match them so the
// address bar and static hosts don't see two spellings of the same page.
const withSlash = (url: string | undefined) =>
  url && !url.endsWith("/") ? `${url}/` : url;
const prev = withSlash(page.url.prev);
const next = withSlash(page.url.next);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center gap-4"
      aria-label={t.a11y.pagination}
    >
      <LinkButton
        disabled={!prev}
        href={prev as string}
        rel={prev ? "prev" : undefined}
        class:list={["select-none", { "opacity-50": !prev }]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!next}
        href={next as string}
        rel={next ? "next" : undefined}
        class:list={["select-none", { "opacity-50": !next }]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
